YOUTUBE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-google-oauth-client-secret
SESSION_SECRET=replace-with-a-long-random-secret

# Set this to the deployed callback URL for production.
# Vercel:  https://your-vercel-domain.vercel.app/api/youtube-callback
YOUTUBE_REDIRECT_URI=http://localhost:8081/api/youtube-callback

# Supabase account sign-in and Postgres. Google provider OAuth credentials are
# configured in Supabase Auth settings, not in these app environment variables.
APP_BASE_URL=http://localhost:8081
SUPABASE_URL=https://pwwqiwedmazxavfkqaje.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
YOUTUBE_TOKEN_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

# Create the key in a Google AI Studio Free Tier project with billing disabled.
# Free-tier Gemini prompts may be used by Google to improve its products.
GEMINI_API_KEY=your-gemini-api-key
# The app pins its verified free-tier model in server code; model overrides are ignored.
