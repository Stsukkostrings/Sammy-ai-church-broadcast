{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/youtube-auth.js": { "maxDuration": 10 },
    "api/youtube-callback.js": { "maxDuration": 15 },
    "api/youtube-channel.js": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/downloads/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
